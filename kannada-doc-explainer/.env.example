# Optional but strongly recommended: Gemini gives far better Kannada OCR (incl. handwriting)
# and plain-English explanations. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tesseract fallback (used when no key is set or the AI call fails)
TESS_LANG=kan+eng

MAX_UPLOAD_MB=8
MAX_PDF_PAGES=3
DB_PATH=data/docs.db
